--- a/.github/workflows/e2e-regression.yml
+++ b/.github/workflows/e2e-regression.yml
@@ -134,10 +134,21 @@
           npx tsx scripts/seed-e2e-fixtures.ts
 
       - name: Start dev server
+        # Backgrounded with `set -m` so the job runs in its own process
+        # group — `kill "$PID"` alone (the prior shape) only ever signals
+        # this one tracked PID. When `npm run dev` is a wrapper spawning
+        # `next dev` as a child, the wrapper exits on SIGTERM but the real
+        # server process is never signaled, so it's orphaned and
+        # accumulates across job runs until the runner's memory cap is hit
+        # (wawagardenbar-app#925 root-caused the runner's week-long Oct
+        # 9-16 crash/restart loop to exactly this). The negative-PID kill
+        # in "Stop dev server" below targets the whole group this starts.
         run: |
           set -euo pipefail
+          set -m
           npm run dev > e2e-server.log 2>&1 &
           echo "$!" > .e2e-server.pid
+          set +m
           echo "Started E2E server pid $(cat .e2e-server.pid)"
 
       - name: Wait for dev server
@@ -295,13 +306,19 @@
 
       - name: Stop dev server
         if: always()
+        # Process-group-safe stop (wawagardenbar-app#925) — see "Start dev
+        # server" above. `kill -TERM -- "-$PID"` signals the whole process
+        # group; the plain-PID kill and pkill -9 -P fallbacks cover
+        # shells/runners where the group signal doesn't reach every child.
         run: |
           set -euo pipefail
           if [ -f .e2e-server.pid ]; then
             PID="$(cat .e2e-server.pid)"
             if kill -0 "$PID" 2>/dev/null; then
-              kill "$PID"
-              wait "$PID" 2>/dev/null || true
+              kill -TERM -- "-${PID}" 2>/dev/null || kill -TERM "$PID" 2>/dev/null || true
+              sleep 2
+              pkill -9 -P "$PID" 2>/dev/null || true
+              kill -9 "$PID" 2>/dev/null || true
             fi
           fi
 
