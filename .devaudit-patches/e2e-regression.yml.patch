+      # Decide which Playwright project to run based on the trigger, and
+      # whether this run qualifies for sharding. Moved ahead of the
+      # dev-server steps (was previously right before "Record E2E
+      # execution context") so both the unsharded and sharded paths below
+      # can branch on `steps.select.outputs.*` from the start.
+      #
+      # PR-to-main runs `critical`; push/deploy-to-main runs `regression`;
+      # workflow_dispatch runs regression with optional spec filter for
+      # scoped iteration.
+      #
+      # Fallback: if the `critical` project isn't defined in
+      # playwright.config.ts (e.g. during migration), fall back to `smoke`
+      # so PR-to-main stays green. Detected via a simple grep of the
+      # config file.
+      #
+      # Sharding (wawagardenbar-app#897, closing #832): only the full,
+      # unscoped `regression` run (deployment_status, or workflow_dispatch
+      # with no `specs` filter) qualifies. The critical tier is already
+      # fast and warmed; a scoped workflow_dispatch run is by definition
+      # small. Neither hits the accumulated process/connection-degradation
+      # failure class #832 diagnosed (isolated reruns pass clean, no
+      # positional/host-ceiling correlation, failure rate scales with
+      # total tests executed) — see e2e-ci-reliability skill's
+      # diagnostic-playbook.md.
+      - name: Determine E2E project + spec selector
+        id: select
+        run: |
+          set -euo pipefail
+          EVENT="${{ github.event_name }}"
+          case "$EVENT" in
+            pull_request)
+              if grep -qE "name:\s*['\"]critical['\"]" playwright.config.ts 2>/dev/null; then
+                echo "project=critical" >> "$GITHUB_OUTPUT"
+                echo "Using critical-tier project (smoke + e2e/critical/)"
+              else
+                echo "project=smoke" >> "$GITHUB_OUTPUT"
+                echo "::warning::No 'critical' Playwright project defined; falling back to smoke."
+              fi
+              echo "specs=" >> "$GITHUB_OUTPUT"
+              echo "sharded=false" >> "$GITHUB_OUTPUT"
+              ;;
+            deployment_status)
+              echo "project=regression" >> "$GITHUB_OUTPUT"
+              echo "specs=" >> "$GITHUB_OUTPUT"
+              echo "sharded=true" >> "$GITHUB_OUTPUT"
+              echo "Running full regression project (sharded)"
+              ;;
+            workflow_dispatch)
+              echo "project=regression" >> "$GITHUB_OUTPUT"
+              echo "specs=${{ github.event.inputs.specs }}" >> "$GITHUB_OUTPUT"
+              if [ -n "${{ github.event.inputs.specs }}" ]; then
+                echo "sharded=false" >> "$GITHUB_OUTPUT"
+                echo "Scoped dispatch: ${{ github.event.inputs.specs }}"
+              else
+                echo "sharded=true" >> "$GITHUB_OUTPUT"
+                echo "Unscoped dispatch — running full regression project (sharded)"
+              fi
+              ;;
+          esac
+
