+      # Sharded full-regression run (wawagardenbar-app#897, closes #832).
+      #
+      # #832 diagnosed the unsharded 576-test/38-min single-worker run as
+      # accumulated process/connection-degradation: a different unrelated
+      # spec fails each run, isolated reruns of the same specs pass clean
+      # 3/3, and the failure rate (~33-50% across repeated full runs) scales
+      # with total tests executed rather than correlating with a specific
+      # position or a host resource ceiling. Sharding — restarting the dev
+      # server fresh between shards — breaks the long-lived-process/
+      # connection-pool pattern without the added cost of a DB reset per
+      # shard (the lighter fix; see e2e-ci-reliability's reliability-fixes.md).
+      #
+      # SHARD_COUNT=4 / ~12min-per-shard budget is a starting point (per the
+      # skill's own guidance), not a hard rule — tune against actual
+      # per-shard wall-clock once this has run for real. Only self-contained
+      # in one job step (a loop, not a GitHub Actions matrix) so the
+      # existing evidence-upload and auto-issue-filing steps below don't
+      # need a parallel-job redesign.
+      - name: Run sharded E2E regression (N shards)
+        if: steps.select.outputs.sharded == 'true'
+        env:
+          PLAYWRIGHT_HTML_REPORTER_OPEN: never
+          SHARD_COUNT: 4
+          SHARD_TIMEOUT_MINUTES: 12
+        run: |
+          set -uo pipefail
+          STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+          OVERALL_STATUS=0
+          OVERALL_OUTCOME="passed"
+
+          for i in $(seq 1 "$SHARD_COUNT"); do
+            echo "::group::Shard $i/$SHARD_COUNT"
+
+            echo "Starting dev server for shard $i"
+            npm run dev > "e2e-server-shard-$i.log" 2>&1 &
+            echo "$!" > .e2e-server.pid
+            echo "Started E2E server pid $(cat .e2e-server.pid) for shard $i"
+
+            timeout --signal=TERM --kill-after=15s 150s npx wait-on http://localhost:3000 --timeout 120000
+
+            # Same route-warm-up as the unsharded path (DevAudit-Installer#793)
+            # — each shard gets a fresh dev-server process, so the JIT
+            # cold-compile tax applies per shard, not just once per job.
+            grep -ohrE "page\.goto\('/[^']*'\)" e2e/ \
+              | sed -E "s/page\.goto\('(.*)'\)/\1/" \
+              | sed -E 's/\?.*//' \
+              | sort -u \
+              | while read -r route; do
+                  curl -sf -o /dev/null --max-time 20 "http://localhost:3000$route" || true
+                done
+
+            PLAYWRIGHT_JSON_OUTPUT_NAME="e2e-regression-results-shard-$i.json" \
+            PLAYWRIGHT_HTML_OUTPUT_DIR="playwright-report-shard-$i" \
+              timeout --signal=TERM --kill-after=60s "${SHARD_TIMEOUT_MINUTES}m" \
+              npx playwright test --project=regression --shard="$i/$SHARD_COUNT" \
+                --reporter=json,html --output="test-results-shard-$i"
+            SHARD_STATUS=$?
+            echo "Shard $i/$SHARD_COUNT exit status: $SHARD_STATUS"
+
+            echo "Stopping dev server for shard $i"
+            if [ -f .e2e-server.pid ]; then
+              PID="$(cat .e2e-server.pid)"
+              if kill -0 "$PID" 2>/dev/null; then
+                kill "$PID"
+                wait "$PID" 2>/dev/null || true
+              fi
+              rm -f .e2e-server.pid
+            fi
+
+            if [ "$SHARD_STATUS" -eq 124 ]; then
+              OVERALL_OUTCOME="timed_out"
+              OVERALL_STATUS=124
+              echo "::error::Shard $i/$SHARD_COUNT exceeded its ${SHARD_TIMEOUT_MINUTES}-minute execution budget."
+            elif [ "$SHARD_STATUS" -ne 0 ] && [ "$OVERALL_STATUS" -ne 124 ]; then
+              OVERALL_OUTCOME="failed"
+              OVERALL_STATUS=1
+            fi
+            echo "::endgroup::"
+          done
+
+          echo "Merging $SHARD_COUNT shard JSON reports into e2e-regression-results.json"
+          if ls e2e-regression-results-shard-*.json >/dev/null 2>&1; then
+            jq -s '.' e2e-regression-results-shard-*.json > e2e-regression-results.json
+          fi
+
+          jq -n \
+            --arg targetUrl "http://localhost:3000" \
+            --arg project "regression" \
+            --arg specs "" \
+            --argjson sharded true \
+            --argjson shardCount "$SHARD_COUNT" \
+            --arg serverStart "npm run dev, restarted per shard" \
+            --arg serverStop "killed per shard" \
+            --arg startedAt "$STARTED_AT" \
+            --arg completedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
+            --argjson timeoutMinutes "$((SHARD_COUNT * SHARD_TIMEOUT_MINUTES))" \
+            --arg outcome "$OVERALL_OUTCOME" \
+            --argjson exitCode "$OVERALL_STATUS" \
+            '{target_url: $targetUrl, project: $project, selected_specs: $specs, sharded: $sharded, shard_count: $shardCount, test_server_start: $serverStart, test_server_stop: $serverStop, timeout_minutes: $timeoutMinutes, started_at: $startedAt, completed_at: $completedAt, outcome: $outcome, exit_code: $exitCode}' \
+            > e2e-regression-metadata.json
+
+          exit "$OVERALL_STATUS"
+
       - name: Stop dev server
         if: always()
         run: |
@@ -291,6 +420,13 @@ jobs:
             # playwright-report/data/, accepted for the debuggability win.
