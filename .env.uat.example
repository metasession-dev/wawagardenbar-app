# Local k3s UAT environment template.
# Copy to .env.uat.local (gitignored via the existing `.env*.local` pattern)
# and fill in real values. Never commit .env.uat.local.
#
# Loaded into the cluster via:
#   kubectl create secret generic wawagardenbar-uat-env -n apps --from-env-file=.env.uat.local
#
# Authoritative variable names come from docs/operations/environment-variables-fixed.md —
# do not reintroduce the old MONGODB_URI/SESSION_SECRET/EMAIL_* names.

# ============================================
# MongoDB
# ============================================
# NOT set here. This project connects to the cluster-shared Mongo instance
# (see ostendo_workhorse_configuration/k3s/manifests/README.md), not a
# per-app Mongo. MONGODB_WAWAGARDENBAR_APP_URI and MONGODB_URI are supplied
# to the app pod by the separate `wawagardenbar-uat-mongo-creds` k8s secret,
# provisioned once via a scoped Mongo user — see k8s/uat/README.md.
MONGODB_DB_NAME=wawagardenbar_uat

# ============================================
# Session
# ============================================
SESSION_PASSWORD=replace_with_a_random_32+_char_string
SESSION_COOKIE_NAME=wawa_uat_session

# ============================================
# Application
# ============================================
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=http://wawagardenbar-app-uat.ostendo.lan
NEXT_PUBLIC_API_URL=http://wawagardenbar-app-uat.ostendo.lan/api
API_URL=http://wawagardenbar-app-uat.ostendo.lan/api

# ============================================
# Monnify Payment Gateway (use sandbox/test credentials for UAT)
# ============================================
MONNIFY_API_KEY=your_monnify_sandbox_api_key
MONNIFY_SECRET_KEY=your_monnify_sandbox_secret_key
MONNIFY_CONTRACT_CODE=your_monnify_sandbox_contract_code
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_WEBHOOK_SECRET=your_monnify_sandbox_webhook_secret
Wallet_Account_Number=your_sandbox_wallet_account_number

# ============================================
# Paystack (use test keys for UAT)
# ============================================
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ============================================
# Email (SMTP)
# ============================================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM=Wawa Garden Bar UAT <uat-noreply@wawagardenbar.com>

# ============================================
# Instagram Integration (optional)
# ============================================
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
