{
  "name": "receipt",
  "language": "en",
  "category": "UTILITY",
  "builder": "receiptParams",
  "header": {
    "format": "TEXT",
    "text": "Receipt for Order #{{1}}",
    "example": ["1234"]
  },
  "body": {
    "text": "Items: {{1}}\n\nTotal: {{2}}\nPaid via: {{3}}\nPoints earned: {{4}}\n\nThanks for choosing Wawa Garden Bar!",
    "example": ["2× Goat Stew, 1× Jollof Rice", "₦5,500", "POS / Card", "55"]
  },
  "footer": "Show this to staff for in-person service",
  "buttons": [
    {
      "type": "URL",
      "text": "View Full Receipt",
      "url": "https://app.wawagardenbar.com/orders/{{1}}",
      "example": ["https://app.wawagardenbar.com/orders/1234"]
    }
  ]
}
